# 18. Calculate inner, outer, and cross products
import numpy as np

a = np.array([1, 2, 3])
b = np.array([4, 5, 6])

inner = np.inner(a, b)
outer = np.outer(a, b)
cross = np.cross(a, b)

print("Inner product:")
print(inner)

print("Outer product:")
print(outer)

print("Cross product:")
print(cross)


