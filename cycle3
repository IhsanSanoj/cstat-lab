# 16. Generate Fibonacci series using Binet Formula
import numpy as np

n = 10

phi = (1 + np.sqrt(5)) / 2
psi = (1 - np.sqrt(5)) / 2

for i in range(n):
    fib = round((phi**i - psi**i) / np.sqrt(5))
    print(fib, end=" ")

print()


